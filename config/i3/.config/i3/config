###################################################
###################################################

# Focus window on mouse hover
focus_follows_mouse yes

###############################
#          APPEARANCE         #
###############################

# Setting font
font pango:DejaVuSansMono Nerd Font 8

# I3 Gaps
gaps inner 10px
smart_gaps on
smart_borders on

# STATUS LINE
bar {
    i3bar_command $HOME/.config/polybar/launch.sh
    height 30
}

###############################
#        WORKSPACES           #
###############################

# WORKSPACES

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# ASSOCIATE MONITORS TO WORKSPACES

set $monitor eDP-1
set $leftMonitor DP-1-3
set $rightMonitor DP-1-1

workspace $ws1 output primary
workspace $ws2 output DP-1-2 DP-1-3 primary
workspace $ws3 output primary
workspace $ws4 output DP-1-2 DP-1-3 primary
workspace $ws5 output primary
workspace $ws6 output DP-1-2 DP-1-3 primary
workspace $ws7 output primary
workspace $ws8 output DP-1-2 DP-1-3 primary
workspace $ws9 output primary
workspace $ws10 output DP-1-2 DP-1-3 primary

# FORCE WORSPACES FOR SOME APPLICATIONS (use xprop | grep WM_CLASS)

# Workspace 1 (Web)
assign [class="Firefox" window_type="normal"] $ws1
# Workspace 2 (Mail)
assign [class="(Thunderbird|Mattermost|KeePassXC)" window_type="normal"] $ws2
# Workspace 3 (Code)
assign [class="Code" window_type="normal"] $ws3
# Workspace 5 (Chrome)
assign [class="Google-chrome" window_type="normal"] $ws5
# Workspace 10 (Obsidian)
assign [class="obsidian" window_type="normal"] $ws10

# Enable floating mode for all zoom dialogs
for_window [class="zoom"  window_type="zoom"] floating enable
# Enable floating mode for all firefox alerts
for_window [window_role="alert"] floating enable

###############################
#            KEYMAPS          #
###############################

include ~/.config/i3/config.d/keybinding.`hostname`.conf

###############################
#            STARTUP          #
###############################

include ~/.config/i3/config.d/startup.`hostname`.conf

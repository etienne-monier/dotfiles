[user]
	name = Etienne Monier
	email = etienne.monier@protonmail.com

[core]
	editor = vim +3 +startinsert
	pager = cat

[commit]
	template = ~/.gitmessagecommit.txt

[alias]
    lg = log --branches --remotes --tags --graph --oneline --decorate

[init]
	defaultBranch = develop

[includeIf "gitdir/i:~/Codes/"]
  path = ~/.gitconfig-work
